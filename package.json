{
  "name": "unified-ds-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nagarro DS Practice hub: knowledge library, opportunity responses, presentations on the Nagarro Master Slides engine, client demos, and the design-system control panel",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite --port 4300 --strictPort",
    "build": "node scripts/typecheck.mjs && vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo && node scripts/check-demo-build.mjs",
    "preview": "vite preview --port 4301",
    "preview:demo": "vite preview --mode demo --outDir dist-demo --port 4302",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/typecheck.mjs",
    "e2e": "playwright test",
    "knowledge:local": "node scripts/snapshot-local-sources.mjs",
    "knowledge:figma": "node scripts/figma-json-to-doc.mjs",
    "slides:sync": "node scripts/sync-nagarro-slides.mjs",
    "tokens:sync": "node scripts/sync-brand-tokens.mjs",
    "tools": "node scripts/tools.mjs",
    "clips": "node scripts/clips.mjs",
    "handbook:md": "vite-node scripts/handbook-md.tsx",
    "covers": "node scripts/post-covers.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/figtree": "^5.2.0",
    "@fontsource-variable/outfit": "^5.2.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@lexical/code": "^0.41.0",
    "@lexical/history": "^0.41.0",
    "@lexical/html": "^0.41.0",
    "@lexical/link": "^0.41.0",
    "@lexical/list": "^0.41.0",
    "@lexical/react": "^0.41.0",
    "@lexical/rich-text": "^0.41.0",
    "@lexical/selection": "^0.41.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-spring/web": "^9.7.5",
    "@visx/axis": "^3.12.0",
    "@visx/brush": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/heatmap": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/xychart": "^3.12.0",
    "immer": "^10.1.0",
    "lexical": "^0.41.0",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "styled-components": "^6.4.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
