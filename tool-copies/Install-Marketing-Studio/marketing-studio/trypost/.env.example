# Local single-user TryPost (Marketing Studio). setup.sh copies this file to .env and fills every
# value marked __GENERATED__ with a fresh random secret. Never share .env.
APP_NAME="Marketing Studio"
# Manual publishing: TryPost never sends a post to a network; you post by hand and mark a post published.
MANUAL_PUBLISHING=true
APP_ENV=production
APP_DEBUG=false
APP_KEY=__GENERATED__
APP_URL=http://localhost:8000
SELF_HOSTED=true
TRYPOST_TARGET=production

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=trypost
DB_USERNAME=trypost
DB_PASSWORD=__GENERATED__

REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=__GENERATED__
REVERB_APP_KEY=__GENERATED__
REVERB_APP_SECRET=__GENERATED__
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

PASSPORT_PRIVATE_KEY=__GENERATED__
PASSPORT_PUBLIC_KEY=__GENERATED__

FILESYSTEM_DISK=public
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Marketing Studio"
POSTHOG_ENABLED=false

# AI through the Claude Code CLI on this Mac (trypost/claude-bridge must be running, see INSTALL.md).
# To use the Anthropic API instead: AI_TEXT_PROVIDER=anthropic and a key in ANTHROPIC_API_KEY, then up -d.
AI_TEXT_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_URL=http://host.docker.internal:8765/v1
OPENAI_COMPATIBLE_API_KEY=local-claude-cli
OPENAI_COMPATIBLE_TEXT_MODEL=sonnet
ANTHROPIC_TEXT_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# TryPost API access for the sync scripts. Create a key in TryPost (Settings, Workspace, API keys)
# and paste it after the =.
TRYPOST_URL=http://localhost:8000
TRYPOST_API_KEY=

# Optional: connect a real X account. The OAuth 2.0 Client ID and Client Secret from the X developer
# portal (your app, User authentication settings, Web App type).
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CLIENT_REDIRECT=http://localhost:8000/accounts/x/callback

# Optional: connect a real Instagram account (Instagram API with Instagram Login): the Instagram app ID
# and secret from the Meta app's Instagram product page.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CLIENT_REDIRECT=http://localhost:8000/accounts/instagram/callback
