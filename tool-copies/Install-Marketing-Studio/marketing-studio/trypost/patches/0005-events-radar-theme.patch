+    width: 3px;
+    border-radius: 0 3px 3px 0;
+    background: var(--er-accent-strong);
+}
+
+[data-sidebar='sidebar'] [data-sidebar='menu-button'] > svg {
+    stroke-width: 1.6;
+}
