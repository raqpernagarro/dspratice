+ * headers and form labels in Roboto Mono, 11px, uppercase.
+ */
+@utility er-label {
+    font-family: var(--font-mono);
+    font-size: 11px;
+    line-height: 16px;
+    font-weight: 500;
+    letter-spacing: 0.04em;
+    text-transform: uppercase;
+    color: var(--er-muted);
+}
+
+/*
+ * The sidebar rail: 36px square items with an 8px radius, the active one on
+ * the soft accent with a 3px Mint bar on its left edge.
+ */
+[data-sidebar='sidebar'] [data-sidebar='menu-button'][data-active='true'] {
+    position: relative;
+}
+
+[data-sidebar='sidebar'] [data-sidebar='menu-button'][data-active='true']::before {
+    content: '';
+    position: absolute;
+    inset-block: 8px;
