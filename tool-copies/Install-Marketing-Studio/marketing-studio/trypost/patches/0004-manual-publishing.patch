diff --git a/tests/Feature/ManualPublishingTest.php b/tests/Feature/ManualPublishingTest.php
new file mode 100644
index 00000000..39ffd902
--- /dev/null
+++ b/tests/Feature/ManualPublishingTest.php
@@ -0,0 +1,244 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Console\Commands\ProcessScheduledPosts;
+use App\Enums\Post\PublishStatus;
+use App\Enums\Post\Status as PostStatus;
+use App\Enums\SocialAccount\Platform;
+use App\Jobs\PublishPost;
+use App\Jobs\PublishToSocialPlatform;
+use App\Models\Post;
+use App\Models\SocialAccount;
+use App\Models\User;
+use App\Models\Workspace;
+use App\Models\WorkspaceLabel;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Queue;
+use Inertia\Testing\AssertableInertia;
+
+/*
+ * Hugo's workspace: with manual publishing on (config trypost.manual_publishing),
+ * nothing is ever sent to a network and the API only stores drafts.
+ */
+
+beforeEach(function () {
+    config(['trypost.manual_publishing' => true]);
+});
+
+function manualPublishingDuePost(): Post
+{
+    $account = SocialAccount::factory()->create([
+        'platform' => Platform::LinkedIn,
+        'scopes' => Platform::LinkedIn->requiredPublishScopes(),
+    ]);
+
+    return Post::factory()->forAccount($account)->scheduled()->create([
+        'user_id' => $account->workspace->user_id,
+        'scheduled_at' => now()->subMinute(),
+        'content' => 'Never sent',
+    ]);
+}
+
+test('the scheduled posts command claims no due post', function () {
+    Queue::fake();
+    $post = manualPublishingDuePost();
+
+    $this->artisan(ProcessScheduledPosts::class)->assertSuccessful();
+
+    Queue::assertNotPushed(PublishPost::class);
+    Queue::assertNotPushed(PublishToSocialPlatform::class);
+    expect($post->fresh()->status)->toBe(PostStatus::Scheduled);
+});
+
+test('the scheduled posts command sends no limit retry', function () {
+    Queue::fake();
+    $post = manualPublishingDuePost();
+    $post->forceFill(['status' => PostStatus::Publishing, 'publish_status' => PublishStatus::Retrying, 'retry_at' => now()->subMinute()])->save();
+
+    $this->artisan(ProcessScheduledPosts::class)->assertSuccessful();
+
+    Queue::assertNotPushed(PublishToSocialPlatform::class);
+    expect($post->fresh()->retry_at)->not->toBeNull();
+});
+
+test('the publish post job leaves the post alone', function () {
+    Queue::fake();
+    $post = manualPublishingDuePost();
+
+    (new PublishPost($post))->handle();
+
+    Queue::assertNotPushed(PublishToSocialPlatform::class);
+    expect($post->fresh()->status)->toBe(PostStatus::Scheduled);
+});
+
+test('the publish to social platform job makes no network call', function () {
+    Http::fake();
+    $post = manualPublishingDuePost();
+
+    (new PublishToSocialPlatform($post))->handle();
+
+    Http::assertNothingSent();
+    expect($post->fresh())
+        ->status->toBe(PostStatus::Scheduled)
+        ->publish_status->toBe(PublishStatus::Pending);
+});
+
+describe('the API', function () {
+    beforeEach(function () {
+        $result = createApiTestToken();
+        $this->plainToken = $result['plain_token'];
+        $this->socialAccount = SocialAccount::factory()->create([
+            'workspace_id' => $result['workspace']->id,
+            'platform' => Platform::LinkedIn,
+        ]);
+    });
+
+    test('refuses a scheduled or publishing post with a clear 422', function (string $status) {
+        Queue::fake();
+
+        $this->withHeaders(['Authorization' => 'Bearer '.$this->plainToken])
+            ->postJson(route('api.posts.store'), [
+                'social_account_id' => $this->socialAccount->id,
+                'content_type' => 'linkedin_post',
+                'content' => 'Hello',
+                'status' => $status,
+                'scheduled_at' => now()->addDay()->toIso8601String(),
+            ])
+            ->assertUnprocessable()
+            ->assertJsonPath('errors.status.0', __('posts.errors.manual_publishing'));
+
+        expect(Post::query()->count())->toBe(0);
+        Queue::assertNotPushed(PublishPost::class);
+    })->with(['scheduled', 'publishing']);
+
+    test('refuses an update to scheduled or publishing', function (string $status) {
+        Queue::fake();
+        $post = Post::factory()->forAccount($this->socialAccount)->draft()->create([
+            'user_id' => $this->socialAccount->workspace->user_id,
+        ]);
+
+        $this->withHeaders(['Authorization' => 'Bearer '.$this->plainToken])
+            ->putJson(route('api.posts.update', $post), [
+                'status' => $status,
+                'scheduled_at' => now()->addDay()->toIso8601String(),
+            ])
+            ->assertUnprocessable()
+            ->assertJsonPath('errors.status.0', __('posts.errors.manual_publishing'));
+
+        expect($post->fresh()->status)->toBe(PostStatus::Draft);
+        Queue::assertNotPushed(PublishPost::class);
+    })->with(['scheduled', 'publishing']);
+
+    test('still creates a draft that keeps its planned date', function () {
+        $when = now()->addDays(2)->startOfMinute();
+
+        $this->withHeaders(['Authorization' => 'Bearer '.$this->plainToken])
+            ->postJson(route('api.posts.store'), [
+                'social_account_id' => $this->socialAccount->id,
+                'content_type' => 'linkedin_post',
+                'content' => 'Planned by hand',
+                'status' => 'draft',
+                'scheduled_at' => $when->toIso8601String(),
+            ])
+            ->assertCreated()
+            ->assertJsonPath('status', PostStatus::Draft->value);
+
+        $post = Post::query()->sole();
+        expect($post->status)->toBe(PostStatus::Draft)
+            ->and($post->scheduled_at?->equalTo($when))->toBeTrue();
+    });
+});
+
+describe('the publish page', function () {
+    beforeEach(function () {
+        $this->user = User::factory()->create();
+        $this->workspace = Workspace::factory()->create(['user_id' => $this->user->id]);
+        $this->workspace->members()->attach($this->user->id, membershipPivot('member'));
+        $this->user->update(['current_workspace_id' => $this->workspace->id]);
+        $this->channel = SocialAccount::factory()->linkedin()->create(['workspace_id' => $this->workspace->id]);
+        $this->posted = WorkspaceLabel::factory()->create(['workspace_id' => $this->workspace->id, 'name' => 'posted']);
+    });
+
+    test('groups posts as draft, planned and published, and never shows a failure', function () {
+        $draft = Post::factory()->forAccount($this->channel)->draft()->create(['user_id' => $this->user->id, 'scheduled_at' => null]);
+        $planned = Post::factory()->forAccount($this->channel)->draft()->create(['user_id' => $this->user->id, 'scheduled_at' => now()->addDays(3)]);
+        $failed = Post::factory()->forAccount($this->channel)->failed()->create(['user_id' => $this->user->id, 'scheduled_at' => now()->subDay()]);
+        $published = Post::factory()->forAccount($this->channel)->draft()->create(['user_id' => $this->user->id, 'scheduled_at' => now()->subDays(2)]);
+        $published->labels()->attach($this->posted);
+
+        $ids = fn (iterable $posts): array => collect($posts)->pluck('id')->sort()->values()->all();
+        $sorted = fn (array $ids): array => collect($ids)->sort()->values()->all();
+
+        $this->actingAs($this->user)
+            ->get(route('app.posts.index', ['tab' => 'queue']))
+            ->assertOk()
+            ->assertInertia(fn (AssertableInertia $page) => $page
+                ->where('manualPublishing', true)
+                ->where('counts.queue', 2)
+                ->where('counts.drafts', 1)
+                ->where('counts.sent', 1)
+                ->loadDeferredProps(fn (AssertableInertia $reload) => $reload
+                    ->missing('queue')
+                    ->where('posts.data', fn ($posts): bool => $ids($posts) === $sorted([$planned->id, $failed->id])
+                        && collect($posts)->every(fn ($post): bool => data_get($post, 'status') === 'draft'
+                            && data_get($post, 'failure') === null
+                            && data_get($post, 'error_message') === null
+                            && data_get($post, 'platform_url') === null))));
+
+        $this->get(route('app.posts.index', ['tab' => 'drafts']))
+            ->assertInertia(fn (AssertableInertia $page) => $page
+                ->loadDeferredProps(fn (AssertableInertia $reload) => $reload
+                    ->where('posts.data', fn ($posts): bool => $ids($posts) === [$draft->id])));
+
+        $this->get(route('app.posts.index', ['tab' => 'sent']))
+            ->assertInertia(fn (AssertableInertia $page) => $page
+                ->loadDeferredProps(fn (AssertableInertia $reload) => $reload
+                    ->where('posts.data', fn ($posts): bool => $ids($posts) === [$published->id])));
+
+        expect($failed->fresh()->status)->toBe(PostStatus::Failed);
+    });
+
+    test('lets a post that failed before the flag be edited as a draft', function () {
+        $failed = Post::factory()->forAccount($this->channel)->failed()->create(['user_id' => $this->user->id, 'scheduled_at' => now()->subDay()]);
+
+        $this->actingAs($this->user)
+            ->get(route('app.posts.edit', $failed))
+            ->assertRedirect(route('app.posts.index', ['edit' => $failed->id]));
+    });
+
+    test('marks a post published through its labels without sending anything', function () {
+        Queue::fake();
+        $post = Post::factory()->forAccount($this->channel)->draft()->create(['user_id' => $this->user->id, 'scheduled_at' => now()->addDay()]);
+
+        $this->actingAs($this->user)
+            ->patch(route('app.posts.labels.update', $post), ['labels' => [$this->posted->id]])
+            ->assertRedirect();
+
+        expect($post->fresh()->labels->pluck('name')->all())->toBe(['posted'])
+            ->and($post->fresh()->status)->toBe(PostStatus::Draft);
+        Queue::assertNotPushed(PublishPost::class);
+    });
+
+    test('filters the calendar by state and counts planned posts per channel', function () {
+        $this->travelTo(now()->startOfWeek()->addDays(2)->setTime(9, 0));
+        $planned = Post::factory()->forAccount($this->channel)->draft()->create(['user_id' => $this->user->id, 'scheduled_at' => now()->addHours(3)]);
+        $published = Post::factory()->forAccount($this->channel)->draft()->create(['user_id' => $this->user->id, 'scheduled_at' => now()->addHours(4)]);
+        $published->labels()->attach($this->posted);
+        Post::factory()->forAccount($this->channel)->draft()->create(['user_id' => $this->user->id, 'scheduled_at' => null]);
+
+        $calendarIds = fn ($posts): array => collect($posts)->flatten(1)->pluck('id')->sort()->values()->all();
+
+        $this->actingAs($this->user)
+            ->get(route('app.calendar', ['view' => 'week', 'status' => 'published']))
+            ->assertOk()
+            ->assertInertia(fn (AssertableInertia $page) => $page
+                ->where('filters.status', 'published')
+                ->where('posts', fn ($posts): bool => $calendarIds($posts) === [$published->id])
+                ->where('channels.0.scheduled_posts_count', 1));
+
+        $this->get(route('app.calendar', ['view' => 'week', 'status' => 'planned']))
+            ->assertInertia(fn (AssertableInertia $page) => $page
+                ->where('posts', fn ($posts): bool => $calendarIds($posts) === [$planned->id]));
+    });
+});
