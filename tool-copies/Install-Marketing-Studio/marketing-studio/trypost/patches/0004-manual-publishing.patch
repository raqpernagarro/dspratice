diff --git a/resources/js/composables/useManualStatus.ts b/resources/js/composables/useManualStatus.ts
new file mode 100644
index 00000000..ceb8d525
--- /dev/null
+++ b/resources/js/composables/useManualStatus.ts
@@ -0,0 +1,171 @@
+import { router, usePage } from '@inertiajs/vue3';
+import { trans } from 'laravel-vue-i18n';
+import { computed, type ComputedRef } from 'vue';
+import { toast } from 'vue-sonner';
+
+import { update as updatePostLabels } from '@/actions/App/Http/Controllers/App/PostLabelController';
+import { store as labelsStore } from '@/routes/app/labels';
+import type { FlashData } from '@/types';
+import { PostOrigin } from '@/types/post';
+
+/**
+ * Hugo's workspace: manual publishing (config `trypost.manual_publishing`,
+ * shared as the `manualPublishing` page prop). TryPost never sends a post;
+ * Hugo posts by hand and marks the post published himself.
+ *
+ * This is the one place the UI derives a post's state. A post is:
+ * - published when it carries the `posted` label (or came from the network),
+ * - planned when it has a planned date (`scheduled_at`),
+ * - a draft otherwise.
+ * The server derives the same states in app/Support/ManualPublishing.php.
+ */
+export type ManualState = 'draft' | 'planned' | 'published';
+
+export const MANUAL_STATES: readonly ManualState[] = [
+    'draft',
+    'planned',
+    'published',
+];
+
+/** The label the sync (scripts/trypost_sync.py) reads to mark a file published. */
+export const POSTED_LABEL = 'posted';
+
+/** The colour the sync gives the label (LABEL_COLOURS in scripts/lib/sync_plan.py). */
+export const POSTED_LABEL_COLOUR = '#C0E50A';
+
+interface ManualLabel {
+    id: string;
+    name: string;
+    color: string;
+}
+
+interface ManualStatusSource {
+    labels?: { name: string }[] | null;
+    scheduled_at?: string | null;
+    origin?: string | null;
+}
+
+export const isMarkedPublished = (post: ManualStatusSource): boolean =>
+    (post.labels ?? []).some((label) => label.name === POSTED_LABEL);
+
+export const manualStateOf = (post: ManualStatusSource): ManualState => {
+    if (isMarkedPublished(post) || post.origin === PostOrigin.Network) {
+        return 'published';
+    }
+
+    return post.scheduled_at ? 'planned' : 'draft';
+};
+
+/** Whether manual publishing is on; on unless the server says otherwise. */
+export const useManualPublishing = (): ComputedRef<boolean> => {
+    const page = usePage();
+
+    return computed(() => page.props.manualPublishing !== false);
+};
+
+export const useManualStatus = (
+    post: () => ManualStatusSource,
+): ComputedRef<ManualState> => computed(() => manualStateOf(post()));
+
+/**
+ * The workspace's `posted` label: the one in `labels`, or a new one created
+ * through the existing label route when the workspace has none.
+ */
+export const ensurePostedLabel = (
+    labels: readonly ManualLabel[],
+): Promise<ManualLabel> => {
+    const existing = labels.find((label) => label.name === POSTED_LABEL);
+
+    if (existing) {
+        return Promise.resolve(existing);
+    }
+
+    return new Promise((resolve, reject) => {
+        let created: ManualLabel | null = null;
+
+        router.post(
+            labelsStore.url(),
+            { name: POSTED_LABEL, color: POSTED_LABEL_COLOUR },
+            {
+                preserveState: true,
+                preserveScroll: true,
+                onFlash: (flash) => {
+                    created = (flash as FlashData).createdLabel ?? null;
+                },
+                onFinish: () => {
+                    if (created) {
+                        resolve(created);
+                    } else {
+                        reject(new Error('The posted label could not be created.'));
+                    }
+                },
+            },
+        );
+    });
+};
+
+/**
+ * Marks a post published (adds `posted`) or not published (removes it)
+ * through the post's existing label update. No network is called.
+ */
+export const setMarkedPublished = async (
+    post: { id: string; labels?: ManualLabel[] | null },
+    published: boolean,
+    workspaceLabels: readonly ManualLabel[],
+    options: { only?: string[]; reset?: string[] } = {},
+): Promise<void> => {
+    const fail = (): void => {
+        toast.error(trans('posts.manual.mark_failed'), {
+            testId: 'post-mark-published-error-toast',
+        });
+    };
+
+    let label: ManualLabel;
+
+    try {
+        label = await ensurePostedLabel([
+            ...(post.labels ?? []),
+            ...workspaceLabels,
+        ]);
+    } catch {
+        fail();
+
+        return;
+    }
+
+    const ids = new Set((post.labels ?? []).map((item) => item.id));
+
+    if (published) {
+        ids.add(label.id);
+    } else {
+        ids.delete(label.id);
+    }
+
+    router.patch(
+        updatePostLabels.url(post.id),
+        { labels: [...ids] },
+        {
+            // The page reloads its posts and counts, so the post moves to its new state and tab.
+            reset: ['posts'],
+            ...options,
+            preserveState: true,
+            preserveScroll: true,
+            onSuccess: () => {
+                toast.success(
+                    trans(
+                        published
+                            ? 'posts.manual.marked_published'
+                            : 'posts.manual.marked_unpublished',
+                    ),
+                    { testId: 'post-mark-published-toast' },
+                );
+            },
+            onError: fail,
+            onHttpException: () => {
+                fail();
+
+                return false;
+            },
+        },
+    );
+};
