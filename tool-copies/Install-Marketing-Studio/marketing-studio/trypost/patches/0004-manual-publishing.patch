new file mode 100644
index 00000000..731871bd
--- /dev/null
+++ b/resources/js/components/publish/ManualStatusChip.vue
@@ -0,0 +1,43 @@
+<script setup lang="ts">
+import type { ManualState } from '@/composables/useManualStatus';
+
+/**
+ * A post's state with manual publishing on (see useManualStatus.ts): a neutral
+ * Draft chip, an accent Planned chip and an ok Published chip, each with a 6px dot.
+ */
+withDefaults(
+    defineProps<{
+        state: ManualState;
+        testId?: string;
+    }>(),
+    { testId: undefined },
+);
+
+const CHIP_CLASSES: Record<ManualState, string> = {
+    draft: 'border border-border bg-secondary text-muted-foreground',
+    planned: 'bg-primary-subtle text-primary-text',
+    published: 'bg-success-subtle text-success-text',
+};
+
+const DOT_CLASSES: Record<ManualState, string> = {
+    draft: 'bg-subtle-foreground',
+    planned: 'bg-primary-text-hover',
+    published: 'bg-success',
+};
+</script>
+
+<template>
+    <span
+        class="inline-flex h-5 shrink-0 items-center gap-1.5 rounded-md px-1.5 text-xs leading-5 font-medium whitespace-nowrap"
+        :class="CHIP_CLASSES[state]"
+        :data-state="state"
+        :data-testid="testId"
+    >
+        <span
+            class="size-1.5 shrink-0 rounded-full"
+            :class="DOT_CLASSES[state]"
+            aria-hidden="true"
+        />
+        {{ $t(`posts.manual.states.${state}`) }}
+    </span>
+</template>
