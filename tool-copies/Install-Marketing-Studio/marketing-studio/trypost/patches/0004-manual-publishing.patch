@@ -0,0 +1,140 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Support;
+
+use App\Enums\Post\Origin;
+use App\Enums\Post\Status;
+use App\Models\Post;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Database\Eloquent\Relations\Relation;
+
+/**
+ * Hugo's workspace: TryPost never sends a post to a network (config
+ * `trypost.manual_publishing`, env MANUAL_PUBLISHING, on by default).
+ *
+ * A post has one of three states, derived from data that is already there:
+ * published when it carries the `posted` label (or came from the network),
+ * planned when it has a date (`scheduled_at`), draft otherwise. Its stored
+ * status is left as it is. The frontend derives the same states in
+ * resources/js/composables/useManualStatus.ts.
+ */
+final class ManualPublishing
+{
+    public const POSTED_LABEL = 'posted';
+
+    public const DRAFT = 'draft';
+
+    public const PLANNED = 'planned';
+
+    public const PUBLISHED = 'published';
+
+    public static function enabled(): bool
+    {
+        return (bool) config('trypost.manual_publishing', true);
+    }
+
+    /**
+     * The statuses a write may ask for: draft only while manual publishing is on.
+     *
+     * @param  list<string>  $statuses
+     * @return list<string>
+     */
+    public static function allowedStatuses(array $statuses): array
+    {
+        if (! self::enabled()) {
+            return $statuses;
+        }
+
+        return array_values(array_diff($statuses, [Status::Scheduled->value, Status::Publishing->value]));
+    }
+
+    public static function refusedMessage(): string
+    {
+        return __('posts.errors.manual_publishing');
+    }
+
+    /**
+     * Validation messages that explain a refused status while the flag is on.
+     *
+     * @return array<string, string>
+     */
+    public static function statusMessages(): array
+    {
+        return self::enabled() ? ['status.in' => self::refusedMessage()] : [];
+    }
+
+    /** The state of one post, read the same way as the query scopes below. */
+    public static function stateOf(Post $post): string
+    {
+        if ($post->origin === Origin::Network || $post->labels()->where('workspace_labels.name', self::POSTED_LABEL)->exists()) {
+            return self::PUBLISHED;
+        }
+
+        return $post->scheduled_at !== null ? self::PLANNED : self::DRAFT;
+    }
+
+    /**
+     * @template TQuery of Builder<Post>|Relation<Post, *, *>
+     *
+     * @param  TQuery  $query
+     * @return TQuery
+     */
+    public static function wherePublished(Builder|Relation $query): Builder|Relation
+    {
+        return $query->where(fn (Builder $published): Builder => $published
+            ->whereHas('labels', fn (Builder $label): Builder => $label->where('workspace_labels.name', self::POSTED_LABEL))
+            ->orWhere('posts.origin', Origin::Network));
+    }
+
+    /**
+     * @template TQuery of Builder<Post>|Relation<Post, *, *>
+     *
+     * @param  TQuery  $query
+     * @return TQuery
+     */
+    public static function whereNotPublished(Builder|Relation $query): Builder|Relation
+    {
+        return $query
+            ->whereDoesntHave('labels', fn (Builder $label): Builder => $label->where('workspace_labels.name', self::POSTED_LABEL))
+            ->where('posts.origin', '!=', Origin::Network);
+    }
+
+    /**
+     * @template TQuery of Builder<Post>|Relation<Post, *, *>
+     *
+     * @param  TQuery  $query
+     * @return TQuery
+     */
+    public static function wherePlanned(Builder|Relation $query): Builder|Relation
+    {
+        return self::whereNotPublished($query)->whereNotNull('posts.scheduled_at');
+    }
+
+    /**
+     * @template TQuery of Builder<Post>|Relation<Post, *, *>
+     *
+     * @param  TQuery  $query
+     * @return TQuery
+     */
+    public static function whereDraft(Builder|Relation $query): Builder|Relation
+    {
+        return self::whereNotPublished($query)->whereNull('posts.scheduled_at');
+    }
+
+    /**
