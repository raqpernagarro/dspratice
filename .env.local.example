# Copy to .env.local (npm run setup does it). .env.local is ignored by git: never commit keys.
# Keys stay on the local dev server; the browser only learns whether each one is configured.

# Model drafting (optional). Without it, drafts come from the template composer, labelled as such.
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. Any current model id works.
ANTHROPIC_MODEL=claude-opus-5-5
# 'default' retries a policy-declined request on Anthropic's recommended fallback model; 'off' disables.
ANTHROPIC_FALLBACKS=default

# Figma REST (optional): in-app Refresh and folder discovery for registered Figma sources.
# Personal access token with scopes file_content:read and projects:read (or folders:read).
FIGMA_TOKEN=

# Engagement calendar (optional): Marketing Studio folders, one per person, as Name=path; separated
# by semicolons. A folder is a Marketing Studio checkout or one brand folder. Only these folders are
# read, and only their posts and their images. A shared folder (for example on OneDrive) lets the
# team see each other's posts.
MARKETING_STUDIO_FOLDERS=
