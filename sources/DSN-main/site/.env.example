# Copy to .env.local. Every value is optional for local development.

# Embed local Storybook (npm run storybook → port 6006) so unpushed stories render in the docs site.
# Wrong ports or a stopped Storybook yield a blank preview — use `npm run dev:docs` to run both.
# NEXT_PUBLIC_STORYBOOK_URL=http://localhost:6006

# Company key for the in-site chat (/prototype/company). Off until set; needs Nagarro sign-in (hosting phase).
# ORG_AI_PROVIDER=gateway        # gateway | anthropic | openai
# ORG_AI_KEY=                    # server-only shared key
# ORG_AI_MODEL=                  # model id for that provider
# ORG_AI_DAILY_TOKENS=200000     # per-person daily budget
