          "figma-console-mcp": {
            "variableId": "VariableID:4816:137014"
          }
        }
      },
      "lg": {
        "$type": "number",
        "$value": 1280,
        "$description": "Min-width breakpoint for standard desktop layouts (≥1280px). Apply desktop layout rules when the viewport width meets or exceeds this value.",
        "$extensions": {
          "figma-console-mcp": {
            "variableId": "VariableID:4816:137015"
          }
        }
      },
      "xl": {
        "$type": "number",
        "$value": 1440,
        "$description": "Min-width breakpoint for large desktop layouts (≥1440px). Apply wide-screen layout rules when the viewport width meets or exceeds this value.",
