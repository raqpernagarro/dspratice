{
  "size": {
    "control": {
      "height": {
        "md": {
          "$type": "number",
          "$value": "{size.md}",
          "$description": "Height of standard-size controls: buttons, inputs, selects, chips, and similar interactive elements.",
          "$extensions": {
            "figma-console-mcp": {
              "variableId": "VariableID:8590:20041"
            }
          }
        },
        "sm": {
          "$type": "number",
          "$value": "{size.sm}",
          "$description": "Height of small/nested controls: secondary buttons, compact inputs, chips inside other controls.",
          "$extensions": {
            "figma-console-mcp": {
              "variableId": "VariableID:8590:20042"
            }
          }
        }
      }
    },
    "border": {
      "sm": {
        "$type": "number",
        "$value": "{primitive.size.1}",
