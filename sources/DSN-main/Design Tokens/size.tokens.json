        "$extensions": {
          "figma-console-mcp": {
            "variableId": "VariableID:111:5775"
          }
        }
      },
      "icon": {
        "$type": "number",
        "$value": 1.25,
        "$description": "Standard line thickness for UI icons",
        "$extensions": {
          "figma-console-mcp": {
            "variableId": "VariableID:111:3138"
          }
        }
      }
    },
    "breakpoint": {
      "sm": {
        "$type": "number",
        "$value": 480,
        "$description": "Max-width breakpoint for mobile layouts (≤480px). Apply mobile-specific layout rules when the viewport width is at or below this value.",
        "$extensions": {
          "figma-console-mcp": {
            "variableId": "VariableID:4816:137013"
          }
        }
      },
      "md": {
        "$type": "number",
        "$value": 768,
        "$description": "Max-width breakpoint for tablet layouts (≤768px). Apply tablet-specific layout rules when the viewport width is at or below this value.",
