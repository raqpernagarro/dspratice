{
  "name": "ds-ngr",
  "version": "0.1.44",
  "main": "./dist/ds-ngr.umd.js",
  "module": "./dist/ds-ngr.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ds-ngr.es.js",
      "require": "./dist/ds-ngr.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css",
    "./global.css": "./dist/global.css"
  },
  "files": [
    "dist",
    "agents",
    "AI.md",
    "AI-short.md",
    "README.md",
    "ds-index.json",
    "specs",
    "!specs/accessibility-audit-*.md",
    "src/components/**/*.spec.md",
    "templates"
  ],
  "type": "module",
  "workspaces": [
    "site",
    "cli"
  ],
  "scripts": {
    "index:generate": "node scripts/generate-index.mjs",
    "check:index": "node scripts/check-index.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "prepare": "node scripts/sync-skills.mjs",
    "prebuild": "node scripts/generate-index.mjs",
    "prestorybook": "node scripts/generate-index.mjs",
    "dev": "npm run storybook",
    "build": "vite build && cp tokens.css dist/tokens.css && mv dist/ds-ngr.css dist/style.css && cp src/styles/global-consumer.css dist/global.css && node scripts/prepend-style-reset.mjs && node scripts/assert-shipped-css.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm test --workspace site && npm test --workspace cli",
    "test:a11y:keyboard-widgets": "vitest run src/components/atoms/MenuCell/MenuCell.test.tsx src/components/atoms/Select/Select.test.tsx src/components/atoms/PhoneInput/PhoneInput.test.tsx src/components/molecules/ChoiceList/ChoiceList.test.tsx src/components/organisms/PopoverMenu/PopoverMenu.test.tsx src/components/atoms/DateTimePicker/DateTimePicker.test.tsx src/components/molecules/Slider/Slider.test.tsx src/components/atoms/OTPInput/OTPInput.test.tsx src/components/molecules/Carousel/Carousel.test.tsx src/components/organisms/MediaViewer/MediaViewer.test.tsx src/components/organisms/NotificationCenter/NotificationCenter.test.tsx src/components/organisms/Command/Command.test.tsx",
    "test:a11y:stories:light": "test-storybook --url \"${STORYBOOK_URL:-http://127.0.0.1:6006}\"",
    "test:a11y:stories:dark": "test-storybook --url \"${STORYBOOK_URL:-http://127.0.0.1:6006}/?globals=theme:dark\"",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "chromatic": "chromatic",
    "story-ui": "story-ui start --port 4001",
    "storybook-with-ui": "concurrently \"npm run storybook\" \"npm run story-ui\"",
    "dev:docs": "concurrently -n storybook,site -c blue,green \"npm run storybook\" \"NEXT_PUBLIC_STORYBOOK_URL=http://localhost:6006 npm run site:dev\"",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:stories": "node scripts/audit-stories.mjs",
    "audit:drift": "node scripts/audit-token-drift.mjs",
    "audit:collisions": "node scripts/audit-token-collisions.mjs",
    "build:tokens:legacy": "style-dictionary build --config style-dictionary.config.mjs",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "apply:tokens": "node scripts/apply-token-changes.mjs --apply",
    "fetch:tokens": "node scripts/fetch-tokens.mjs",
    "fetch:components": "node scripts/fetch-figma-components.mjs",
    "sync:components": "node scripts/sync-components.mjs",
    "site:dev": "npm run dev --workspace site",
    "site:build": "npm run build --workspace site"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@lexical/code": "^0.41.0",
    "@lexical/history": "^0.41.0",
    "@lexical/html": "^0.41.0",
    "@lexical/link": "^0.41.0",
    "@lexical/list": "^0.41.0",
    "@lexical/react": "^0.41.0",
    "@lexical/rich-text": "^0.41.0",
    "@lexical/selection": "^0.41.0",
    "@react-spring/web": "^9.7.5",
    "@storybook/addon-docs": "^10.3.5",
    "@visx/axis": "^3.12.0",
    "@visx/brush": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/heatmap": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/xychart": "^3.12.0",
    "esbuild": "^0.27.4",
    "lexical": "^0.41.0",
    "lucide-react": "^0.575.0",
    "react-live": "^4.1.8",
    "react-zoom-pan-pinch": "^3.7.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-mcp": "^0.4.2",
    "@storybook/react-vite": "^10.3.5",
    "@storybook/test-runner": "^0.26.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@tpitre/story-ui": "^4.16.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.0",
    "chromatic": "^15.2.0",
    "concurrently": "^8.2.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.3.5",
    "style-dictionary": "^5.3.2",
    "styled-components": "^6.4.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "styled-components": "^6.1.13"
  }
}
