{
  "name": "nagarro-ds-starter-pack",
  "version": "1.0.0",
  "private": true,
  "description": "Design system starter pack: Base UI components in React and Figma, generated from specs on semantic tokens.",
  "exports": {
    ".": "./stories/base-ui/components/index.ts"
  },
  "scripts": {
    "help": "node scripts/help.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "sync:docs": "node scripts/sync-base-ui-docs.mjs",
    "generate:demos": "node scripts/generate-official-demos.mjs",
    "generate:stories": "node scripts/generate-base-ui-stories.mjs",
    "figma:sync-from": "npm run sync-figma-to-tokens --prefix variables-github-action",
    "figma:sync-to": "npm run sync-tokens-to-figma --prefix variables-github-action",
    "figma:sync-semantics": "npm run figma:link-modes && cd variables-github-action && npx tsx ../scripts/sync-figma-semantic-css.mjs",
    "figma:component-spec": "node scripts/generate-component-button-token-spec.mjs",
    "figma:export-components": "node scripts/export-components-tokens-json.mjs",
    "figma:shared-overlay": "npm run figma:component-spec && node scripts/generate-figma-shared-overlay.mjs",
    "figma:build-rebind-map": "npm run figma:component-spec && npm run figma:export-components",
    "editor:dev": "vite --config semantic-editor/vite.config.ts",
    "editor:build": "vite build --config semantic-editor/vite.config.ts",
    "docs:build": "VITE_DS_READONLY=1 vite build --config semantic-editor/vite.config.ts --outDir dist-docs --base ./",
    "fonts:sync": "node scripts/sync-google-fonts.mjs",
    "figma:link-modes": "cd variables-github-action && npx tsx ../scripts/link-semantic-modes.mjs",
    "plugin:build": "node figma-plugin/build.mjs",
    "plugin:check": "tsc -p figma-plugin/tsconfig.json",
    "figma:sync-from-file": "cd variables-github-action && npx tsx ../scripts/sync-figma-semantic-css.mjs --from-file",
    "plugin:install": "node figma-plugin/build.mjs --install",
    "ds:generate": "variables-github-action/node_modules/.bin/tsx scripts/ds/generate.ts",
    "ds:ai-docs": "variables-github-action/node_modules/.bin/tsx scripts/ds/generate-ai-docs.ts",
    "ds:parity": "variables-github-action/node_modules/.bin/tsx scripts/ds/check-figma-parity.ts",
    "ds:code-connect": "variables-github-action/node_modules/.bin/tsx scripts/ds/generate-code-connect.ts",
    "ds:contrast": "variables-github-action/node_modules/.bin/tsx scripts/ds/check-contrast.ts",
    "ds:figma-bind": "variables-github-action/node_modules/.bin/tsx scripts/ds/figma-bind.ts",
    "ds:figma-build": "variables-github-action/node_modules/.bin/tsx scripts/ds/figma-build.ts",
    "ds:figma-scan": "variables-github-action/node_modules/.bin/tsx scripts/ds/figma-scan.ts",
    "ds:apply-project": "variables-github-action/node_modules/.bin/tsx scripts/ds/apply-project.ts",
    "ds:reset": "node scripts/ds/reset.mjs",
    "ds:anatomy": "variables-github-action/node_modules/.bin/tsx scripts/ds/figma-scan.ts import",
    "ds:figma-runtime": "variables-github-action/node_modules/.bin/tsx scripts/ds/figma-runtime.ts",
    "ds:figma-docs": "variables-github-action/node_modules/.bin/tsx scripts/ds/figma-docs.ts",
    "ds:figma-icons": "variables-github-action/node_modules/.bin/tsx scripts/ds/figma-icons.ts",
    "pitch:build": "variables-github-action/node_modules/.bin/tsx scripts/pitch/build.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-highlight": "^7.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@anthropic-ai/sdk": "^0.135.0",
    "@chromatic-com/storybook": "^5.5.1",
    "@figma/code-connect": "^2.0.2",
    "@figma/plugin-typings": "^1.141.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "playwright": "^1.64.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  }
}
